                  description="Especifica la instrucción SQL utilizada por el componente para extraer datos."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT       Inscripcion.ID_Inscripcion, Cliente.DNI, Sede.ID_Sede, Membresia.ID_Membresia, Inscripcion.Fecha_Inscripcion, Inscripcion.Fecha_Fin, Inscripcion.Monto_Pagado
FROM            Inscripcion INNER JOIN
                         Cliente ON Inscripcion.DNI = Cliente.DNI INNER JOIN
                         Sede ON Inscripcion.ID_Sede = Sede.ID_Sede INNER JOIN
                         Membresia ON Inscripcion.ID_Membresia = Membresia.ID_Membresia</property>
                <property
